{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-desk.local/schemas/token-risk-rating.schema.json",
  "title": "Complete Token Risk Rating Record",
  "description": "Single self-contained storage and audit record for one exact-object, exact-route token risk assessment.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "methodology_version",
    "rating_series_id",
    "rating_id",
    "rating_version",
    "supersedes_rating_id",
    "status",
    "frozen_at",
    "created_at",
    "updated_at",
    "rated_object",
    "assumptions",
    "sources",
    "layers",
    "edges",
    "score_formation_specifications",
    "factor_evaluations",
    "component_evaluations",
    "risk_conditions",
    "attachments",
    "operators",
    "propagation_steps",
    "critical_path_records",
    "mitigation_effectiveness_records",
    "gaps",
    "reconciliation_records",
    "limitation_records",
    "conclusions",
    "final_output",
    "approvals",
    "audit",
    "change_log"
  ],
  "properties": {
    "schema_version": { "const": "2.0.2-alpha" },
    "methodology_version": { "type": "string", "minLength": 1 },
    "rating_series_id": { "$ref": "#/$defs/id" },
    "rating_id": { "$ref": "#/$defs/id" },
    "rating_version": { "type": "integer", "minimum": 1 },
    "supersedes_rating_id": { "$ref": "#/$defs/nullable_id" },
    "status": {
      "enum": ["draft", "in_review", "approved", "watchlist", "no_rate", "rejected", "superseded"]
    },
    "frozen_at": { "type": "string", "format": "date-time" },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "rated_object": { "$ref": "#/$defs/rated_object" },
    "assumptions": {
      "type": "array",
      "items": { "$ref": "#/$defs/assumption" }
    },
    "sources": {
      "type": "array",
      "items": { "$ref": "#/$defs/source" }
    },
    "layers": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/layer" }
    },
    "edges": {
      "type": "array",
      "items": { "$ref": "#/$defs/edge" }
    },
    "score_formation_specifications": {
      "type": "array",
      "items": { "$ref": "#/$defs/score_formation_specification" }
    },
    "factor_evaluations": {
      "type": "array",
      "items": { "$ref": "#/$defs/factor_evaluation" }
    },
    "component_evaluations": {
      "type": "array",
      "items": { "$ref": "#/$defs/component_evaluation" }
    },
    "risk_conditions": {
      "type": "array",
      "items": { "$ref": "#/$defs/risk_condition" }
    },
    "attachments": {
      "type": "array",
      "items": { "$ref": "#/$defs/attachment" }
    },
    "operators": {
      "type": "array",
      "items": { "$ref": "#/$defs/operator" }
    },
    "propagation_steps": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/propagation_step" }
    },
    "critical_path_records": {
      "type": "array",
      "items": { "$ref": "#/$defs/critical_path_record" }
    },
    "mitigation_effectiveness_records": {
      "type": "array",
      "items": { "$ref": "#/$defs/mitigation_effectiveness_record" }
    },
    "gaps": {
      "type": "array",
      "items": { "$ref": "#/$defs/gap" }
    },
    "reconciliation_records": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/reconciliation_record" }
    },
    "limitation_records": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/limitation_record" }
    },
    "conclusions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/conclusion" }
    },
    "final_output": { "$ref": "#/$defs/final_output" },
    "approvals": {
      "type": "array",
      "items": { "$ref": "#/$defs/approval" }
    },
    "audit": { "$ref": "#/$defs/audit" },
    "change_log": {
      "type": "array",
      "items": { "$ref": "#/$defs/change" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "nullable_id": {
      "oneOf": [
        { "$ref": "#/$defs/id" },
        { "type": "null" }
      ]
    },
    "score_0_1": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "nullable_score_0_1": {
      "oneOf": [
        { "$ref": "#/$defs/score_0_1" },
        { "type": "null" }
      ]
    },
    "evidence_state": {
      "enum": ["complete", "partial", "stale", "contradictory", "missing", "unevaluable"]
    },
    "confidence": {
      "description": "Confidence in the result. NO_RATE and REJECT are disposition statuses, not confidence levels.",
      "enum": ["High", "Medium", "Low"]
    },
    "nullable_confidence": {
      "oneOf": [
        { "$ref": "#/$defs/confidence" },
        { "type": "null" }
      ]
    },
    "materiality": {
      "description": "Functional materiality under the methodology's precedence rule: Required, then Dominant, then Modifier, then Immaterial. This is distinct from the observed risk score.",
      "enum": ["Required", "Dominant", "Modifier", "Immaterial"]
    },
    "component_type": {
      "enum": ["Instrument Mechanics", "Claim", "Substance / Yield Source", "Venue / Infrastructure", "Evidence / Confidence"]
    },
    "impact_pathway": {
      "enum": ["payoff", "NAV", "redemption", "recovery", "liquidation", "valuation", "custody", "transfer", "settlement", "exit", "confidence"]
    },
    "rated_object": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "economic_form",
        "chain",
        "contract_or_market",
        "rated_route",
        "custody_route",
        "redemption_or_exit_route",
        "position_size_assumption",
        "token_family_lane",
        "primary_loss_object",
        "secondary_loss_objects",
        "review_date",
        "source_cutoff",
        "scope_exclusions"
      ],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "economic_form": { "type": "string", "minLength": 1 },
        "chain": { "type": "string", "minLength": 1 },
        "contract_or_market": { "type": "string", "minLength": 1 },
        "maturity": { "type": ["string", "null"], "format": "date-time" },
        "rated_route": { "type": "string", "minLength": 1 },
        "custody_route": { "type": "string", "minLength": 1 },
        "redemption_or_exit_route": { "type": "string", "minLength": 1 },
        "position_size_assumption": { "type": "string", "minLength": 1 },
        "token_family_lane": { "type": "string", "minLength": 1 },
        "primary_loss_object": { "type": "string", "minLength": 1 },
        "secondary_loss_objects": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "review_date": { "type": "string", "format": "date" },
        "source_cutoff": { "type": "string", "format": "date" },
        "scope_exclusions": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "assumption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assumption_id", "statement", "type", "materiality", "sensitivity", "status"],
      "properties": {
        "assumption_id": { "$ref": "#/$defs/id" },
        "statement": { "type": "string", "minLength": 1 },
        "type": { "enum": ["observed", "analyst_assumption", "methodology_rule", "unresolved"] },
        "materiality": { "$ref": "#/$defs/materiality" },
        "sensitivity": { "type": "string", "minLength": 1 },
        "status": { "enum": ["active", "resolved", "expired", "superseded"] }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "title", "uri", "source_type", "publisher", "retrieval_status", "evidence_quality", "inspected_at", "exact_anchor"],
      "properties": {
        "source_id": { "$ref": "#/$defs/id" },
        "title": { "type": "string", "minLength": 1 },
        "uri": { "type": "string", "minLength": 1 },
        "source_type": { "enum": ["official_docs", "official_api", "onchain", "legal", "audit", "attestation", "market_data", "rating_agency", "regulator", "third_party", "internal_workpaper"] },
        "publisher": { "type": "string", "minLength": 1 },
        "retrieval_status": { "enum": ["fetched", "local_inspected", "snippet_only", "failed", "not_inspected"] },
        "evidence_quality": { "enum": ["strong", "medium", "weak", "unsupported"] },
        "inspected_at": { "type": "string", "format": "date-time" },
        "exact_anchor": { "type": "string", "minLength": 1 },
        "content_hash": { "type": ["string", "null"] }
      }
    },
    "layer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layer_id", "parent_layer_id", "object_name", "function", "instrument_route", "venue_route", "materiality", "materiality_reason", "horizon", "assessment_status", "non_assessment_reason", "evidence_outcome", "source_ids"],
      "properties": {
        "layer_id": { "$ref": "#/$defs/id" },
        "parent_layer_id": { "$ref": "#/$defs/nullable_id" },
        "object_name": { "type": "string", "minLength": 1 },
        "function": { "type": "string", "minLength": 1 },
        "instrument_route": { "type": "string", "minLength": 1 },
        "venue_route": { "type": "string", "minLength": 1 },
        "materiality": { "$ref": "#/$defs/materiality" },
        "materiality_reason": { "type": "string", "minLength": 1 },
        "horizon": { "type": "string", "minLength": 1 },
        "assessment_status": { "enum": ["assessed", "unassessed_early_stop"] },
        "non_assessment_reason": { "type": ["string", "null"], "minLength": 1 },
        "evidence_outcome": {
          "description": "Layer-level evidence confidence outcome. Evidence state is recorded on the underlying evaluations and Risk Conditions.",
          "$ref": "#/$defs/confidence"
        },
        "source_ids": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true }
      },
      "allOf": [
        {
          "if": { "properties": { "assessment_status": { "const": "assessed" } } },
          "then": { "properties": { "non_assessment_reason": { "type": "null" } } },
          "else": { "properties": { "non_assessment_reason": { "type": "string", "minLength": 1 } } }
        }
      ]
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["edge_id", "parent_layer_id", "child_layer_id", "edge_type", "graph_role", "failure_condition", "impact_pathways", "materiality", "source_ids"],
      "properties": {
        "edge_id": { "$ref": "#/$defs/id" },
        "parent_layer_id": { "$ref": "#/$defs/id" },
        "child_layer_id": { "$ref": "#/$defs/id" },
        "edge_type": { "enum": ["wraps", "transforms", "references", "settles_into", "redeems_into", "withdraws_from", "backed_by", "collateralized_by", "earns_from", "priced_by", "controlled_by", "custodied_by", "executed_on", "depends_on"] },
        "graph_role": { "enum": ["D", "I", "S", "R"] },
        "failure_condition": { "type": "string", "minLength": 1 },
        "impact_pathways": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/impact_pathway" }, "uniqueItems": true },
        "materiality": { "$ref": "#/$defs/materiality" },
        "source_ids": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true }
      }
    },
    "score_formation_specification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["score_formation_specification_id", "route_module", "version", "status", "component_types", "factor_definition_ids", "applicability_and_na_rule", "anchor_and_boundary_rule", "combining_rule", "dominance_and_override_rule", "missing_evidence_rule", "component_formula", "route_weight_allocation", "lineage_rule", "rounding_rule", "worked_boundary_examples", "owner", "independent_validator", "approver", "effective_date", "review_date", "change_id"],
      "properties": {
        "score_formation_specification_id": { "$ref": "#/$defs/id" },
        "route_module": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "status": { "enum": ["draft", "approved", "expired", "superseded"] },
        "calculator_id": { "type": ["string", "null"], "minLength": 1 },
        "calculator_version": { "type": ["string", "null"], "minLength": 1 },
        "test_vector_ids": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
        "component_types": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/component_type" }, "uniqueItems": true },
        "factor_definition_ids": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
        "applicability_and_na_rule": { "type": "string", "minLength": 1 },
        "anchor_and_boundary_rule": { "type": "string", "minLength": 1 },
        "combining_rule": { "type": "string", "minLength": 1 },
        "dominance_and_override_rule": { "type": "string", "minLength": 1 },
        "missing_evidence_rule": { "type": "string", "minLength": 1 },
        "component_formula": { "type": "string", "minLength": 1 },
        "route_weight_allocation": { "type": "string", "minLength": 1 },
        "lineage_rule": { "type": "string", "minLength": 1 },
        "rounding_rule": { "type": "string", "minLength": 1 },
        "worked_boundary_examples": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "owner": { "type": "string", "minLength": 1 },
        "independent_validator": { "type": "string", "minLength": 1 },
        "approver": { "type": "string", "minLength": 1 },
        "effective_date": { "type": ["string", "null"], "format": "date" },
        "review_date": { "type": "string", "format": "date" },
        "change_id": { "$ref": "#/$defs/nullable_id" }
      }
    },
    "factor_evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["factor_evaluation_id", "factor_definition_id", "layer_id", "component_evaluation_id", "factor_name", "applicability", "score", "materiality", "failure_condition", "impact_pathways", "horizon", "evidence_state", "source_ids", "rationale", "arithmetic_role", "attribution", "primary_carrier_id", "risk_condition_id", "diagnostic_contribution", "chargeable_contribution"],
      "properties": {
        "factor_evaluation_id": { "$ref": "#/$defs/id" },
        "factor_definition_id": { "$ref": "#/$defs/id" },
        "layer_id": { "$ref": "#/$defs/id" },
        "component_evaluation_id": { "$ref": "#/$defs/id" },
        "factor_name": { "type": "string", "minLength": 1 },
        "applicability": { "enum": ["applicable", "N/A"] },
        "score": { "$ref": "#/$defs/nullable_score_0_1" },
        "materiality": { "$ref": "#/$defs/materiality" },
        "failure_condition": { "type": "string", "minLength": 1 },
        "impact_pathways": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/impact_pathway" }, "uniqueItems": true },
        "horizon": { "type": "string", "minLength": 1 },
        "evidence_state": { "$ref": "#/$defs/evidence_state" },
        "source_ids": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
        "rationale": { "type": "string", "minLength": 1 },
        "arithmetic_role": { "enum": ["directly_weighted", "component_input", "diagnostic_only"] },
        "attribution": { "enum": ["NEW", "CARRIED", "SHARED", "N/A"] },
        "primary_carrier_id": { "$ref": "#/$defs/nullable_id" },
        "risk_condition_id": { "$ref": "#/$defs/nullable_id" },
        "diagnostic_contribution": { "type": ["number", "null"], "minimum": 0 },
        "chargeable_contribution": { "type": ["number", "null"], "minimum": 0 }
      }
    },
    "component_evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component_evaluation_id", "layer_id", "component_type", "score_formation_specification_id", "route_weight", "score", "aggregation_method", "factor_evaluation_ids", "diagnostic_contribution", "attribution", "primary_carrier_id", "chargeable_contribution", "rationale"],
      "properties": {
        "component_evaluation_id": { "$ref": "#/$defs/id" },
        "layer_id": { "$ref": "#/$defs/id" },
        "component_type": { "$ref": "#/$defs/component_type" },
        "score_formation_specification_id": { "$ref": "#/$defs/id" },
        "route_weight": { "type": "number", "minimum": 0, "maximum": 1 },
        "score": { "$ref": "#/$defs/nullable_score_0_1" },
        "aggregation_method": { "type": "string", "minLength": 1 },
        "factor_evaluation_ids": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
        "diagnostic_contribution": { "type": "number", "minimum": 0 },
        "attribution": { "enum": ["NEW", "CARRIED", "SHARED", "MIXED", "N/A"] },
        "primary_carrier_id": { "$ref": "#/$defs/nullable_id" },
        "chargeable_contribution": { "type": "number", "minimum": 0 },
        "rationale": { "type": "string", "minLength": 1 }
      }
    },
    "risk_condition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["risk_condition_id", "canonical_object", "scope", "risk_class", "failure_condition", "primary_impact_pathway", "horizon", "common_cause_group", "materiality", "evidence_state", "source_ids", "economic_effect_mode", "primary_carrier_id", "operator_ids", "owner", "reviewer", "status"],
      "properties": {
        "risk_condition_id": { "$ref": "#/$defs/id" },
        "canonical_object": { "type": "string", "minLength": 1 },
        "scope": { "type": "string", "minLength": 1 },
        "risk_class": { "type": "string", "minLength": 1 },
        "failure_condition": { "type": "string", "minLength": 1 },
        "primary_impact_pathway": { "$ref": "#/$defs/impact_pathway" },
        "horizon": { "type": "string", "minLength": 1 },
        "common_cause_group": { "$ref": "#/$defs/nullable_id" },
        "materiality": { "$ref": "#/$defs/materiality" },
        "evidence_state": { "$ref": "#/$defs/evidence_state" },
        "source_ids": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
        "economic_effect_mode": { "enum": ["carrier", "operator", "carrier_and_operator", "immaterial_diagnostic"] },
        "primary_carrier_id": { "$ref": "#/$defs/nullable_id" },
        "operator_ids": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
        "owner": { "type": "string", "minLength": 1 },
        "reviewer": { "type": "string", "minLength": 1 },
        "status": { "enum": ["draft", "approved", "stale", "superseded"] }
      }
    },
    "attachment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attachment_id", "risk_condition_id", "layer_id", "edge_id", "graph_role", "attribution", "primary_carrier_id", "immediate_consequence", "impact_pathways", "materiality", "operator_ids", "source_ids", "rationale"],
      "properties": {
        "attachment_id": { "$ref": "#/$defs/id" },
        "risk_condition_id": { "$ref": "#/$defs/id" },
        "layer_id": { "$ref": "#/$defs/id" },
        "edge_id": { "$ref": "#/$defs/nullable_id" },
        "graph_role": { "enum": ["D", "I", "S", "R"] },
        "attribution": { "enum": ["NEW", "CARRIED", "SHARED"] },
        "primary_carrier_id": { "$ref": "#/$defs/nullable_id" },
        "immediate_consequence": { "type": "string", "minLength": 1 },
        "impact_pathways": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/impact_pathway" }, "uniqueItems": true },
        "materiality": { "$ref": "#/$defs/materiality" },
        "operator_ids": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
        "source_ids": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
        "rationale": { "type": "string", "minLength": 1 }
      }
    },
    "operator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operator_id", "operator_type", "target_id", "threshold_or_result", "trigger", "evidence_source_ids", "binding", "effect", "owner", "approver", "effective_date", "expiry_or_review_date"],
      "properties": {
        "operator_id": { "$ref": "#/$defs/id" },
        "operator_type": { "enum": ["NONE", "RISK_SCORE_FLOOR", "RATING_CEILING", "CONFIDENCE_CEILING", "WATCHLIST", "NO_RATE", "REJECT"] },
        "target_id": { "$ref": "#/$defs/id" },
        "threshold_or_result": { "type": "string", "minLength": 1 },
        "trigger": { "type": "string", "minLength": 1 },
        "evidence_source_ids": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
        "binding": { "type": "boolean" },
        "effect": { "type": "string", "minLength": 1 },
        "owner": { "type": "string", "minLength": 1 },
        "approver": { "type": "string", "minLength": 1 },
        "effective_date": { "type": "string", "format": "date" },
        "expiry_or_review_date": { "type": "string", "format": "date" }
      }
    },
    "propagation_step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layer_id", "child_layer_ids", "inherited_risk", "incremental_risk", "pre_operator_risk", "operator_ids", "indicated_risk", "indicated_grade", "indicated_confidence", "binding_driver_ids", "calculation"],
      "properties": {
        "layer_id": { "$ref": "#/$defs/id" },
        "child_layer_ids": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
        "inherited_risk": { "type": "number", "minimum": 0 },
        "incremental_risk": { "type": "number", "minimum": 0 },
        "pre_operator_risk": { "type": "number", "minimum": 0 },
        "operator_ids": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
        "indicated_risk": { "type": "number", "minimum": 0 },
        "indicated_grade": { "enum": ["A", "BBB", "BB", "B", "CCC", "CC", "C", "D", "NO_RATE", "REJECT"] },
        "indicated_confidence": { "$ref": "#/$defs/confidence" },
        "binding_driver_ids": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
        "calculation": { "type": "string", "minLength": 1 }
      }
    },
    "critical_path_record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["critical_path_record_id", "trigger", "affected_ids", "joint_or_sequential_failure_condition", "critical_date", "current_state", "expected_state", "stress_state", "recovery_or_substitution_time", "common_cause", "max_child_conservative", "max_child_rationale", "consequence_operator_ids", "scenario_result", "evidence_source_ids", "owner", "reviewer", "next_review_date", "status"],
      "properties": {
        "critical_path_record_id": { "$ref": "#/$defs/id" },
        "trigger": { "type": "string", "minLength": 1 },
